{
  "name": "rainsday-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render:hero": "remotion render src/index.ts HeroSignal ../assets/hero-bg.mp4 --concurrency=1 --codec=h264 --crf=22",
    "render:mission": "remotion render src/index.ts MissionSignal ../assets/signal-mission.mp4 --concurrency=1 --codec=h264 --crf=22",
    "render:product": "remotion render src/index.ts ProductSignal ../assets/signal-product.mp4 --concurrency=1 --codec=h264 --crf=22",
    "render:campaign": "remotion render src/index.ts CampaignSignal ../assets/signal-campaign.mp4 --concurrency=1 --codec=h264 --crf=22",
    "render:all": "npm run render:hero && npm run render:mission && npm run render:product && npm run render:campaign",
    "render:v2:cobalt": "remotion render src/index.ts CobaltSubject ../v2/assets/cobalt-subject.mp4 --concurrency=1 --codec=h264 --crf=22"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.250",
    "@remotion/cli": "^4.0.250",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.250"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.6.3"
  }
}
